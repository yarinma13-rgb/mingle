# Copy to .env and fill only what you have. Pipeline runs in demo mode without keys.

# OpenAI — used by scorer.py + personalize.py (gpt-4o-mini is cheapest)
OPENAI_API_KEY=

# Hunter.io free tier — email find/verify (https://hunter.io/api)
HUNTER_API_KEY=

# Optional: Anymail Finder fallback
ANYMAIL_API_KEY=

# Google Sheets CRM (service account JSON path + sheet ID)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
GOOGLE_SHEET_ID=

# Pipeline knobs
ICP_MIN_SCORE=85
DEMO_MODE=true
# Outreach message language: he (Hebrew) or en (English)
COPY_LANGUAGE=he
# Keep false to lock founder-approved Hebrew templates (recommended)
USE_AI_COPY=false
# Public app URL used inside unique interest links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HMAC secret for /r/[token] links (must match Vercel OUTBOUND_LINK_SECRET)
OUTBOUND_LINK_SECRET=
# Auto-email founder copy once after interest-link click (needs RESEND_API_KEY + lead Email)
OUTBOUND_FOLLOWUP_ON_CLICK=true
