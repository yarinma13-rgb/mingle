NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side PostHog for founder insights email (HogQL)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=
# Founder UX insights inbox (biweekly Resend report). Falls back to ADMIN_EMAILS.
FOUNDERS_REPORT_EMAIL=
# Protects /api/cron/insights-report and /api/cron/purge-deleted-accounts
CRON_SECRET=
# Optional. Set to 1 on the cron runner to fire pilot growth nudge emails (needs service role + Resend).
GROWTH_NUDGES_ENABLED=
# Optional. npm run growth:report with GROWTH_REPORT_WRITE=1 saves docs/growth-reports/YYYY-MM-DD.md
GROWTH_REPORT_WRITE=
# Required for hard-deleting accounts after the 14-day grace window
# (GET /api/cron/purge-deleted-accounts with Authorization: Bearer $CRON_SECRET).
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Raises GitHub API rate limits for public user/repo metadata.
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Structures pasted job descriptions into editable role sections.
GEMINI_API_KEY=
