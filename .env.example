NEXT_PUBLIC_SUPABASE_URL=
# After Supabase custom domain is active (see docs/AUTH_GOOGLE_BRANDING.md),
# prefer https://auth.mingle.careers so Google OAuth does not show *.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side PostHog for founder insights email (HogQL)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=
# Founder UX insights inbox (biweekly Resend report). Falls back to ADMIN_EMAILS.
FOUNDERS_REPORT_EMAIL=
# Protects /api/cron/insights-report and /api/cron/purge-deleted-accounts
CRON_SECRET=
# Shared HMAC secret for unique outbound interest links (/r/[token]).
# Falls back to CRON_SECRET if unset.
OUTBOUND_LINK_SECRET=
# Optional. Set to 1 on the cron runner to fire pilot growth nudge emails (needs service role + Resend).
GROWTH_NUDGES_ENABLED=
# Optional. npm run growth:report with GROWTH_REPORT_WRITE=1 saves docs/growth-reports/YYYY-MM-DD.md
GROWTH_REPORT_WRITE=
# Optional. Company user ids (comma-separated) exempt from Discover domain filtering (test accounts).
DISCOVER_DOMAIN_EXEMPT_USER_IDS=
# Optional. Company emails exempt from Discover domain filtering.
DISCOVER_DOMAIN_EXEMPT_EMAILS=
# Required for hard-deleting accounts after the 14-day grace window
# (GET /api/cron/purge-deleted-accounts with Authorization: Bearer $CRON_SECRET).
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
# When true (default), /r/[token] sends one founder-approved follow-up email via Resend after click (requires email in token).
OUTBOUND_FOLLOWUP_ON_CLICK=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Raises GitHub API rate limits for public user/repo metadata.
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as GOOGLE_CLIENT_ID above, just exposed to the browser — Google
# client IDs aren't secret. Needed by the "Continue with Google" button on
# the auth page (Google Identity Services popup flow, see
# docs/AUTH_GOOGLE_BRANDING.md and app/api/auth/google/login-exchange).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional. Structures pasted job descriptions into editable role sections.
GEMINI_API_KEY=
# Optional. External Opportunities engine (docs/EXTERNAL_JOBS.md). GEMINI_API_KEY
# is required for it to publish anything; without it collected jobs wait in
# Pending Review. Daily cron: GET /api/cron/external-jobs (CRON_SECRET +
# SUPABASE_SERVICE_ROLE_KEY).
EXTERNAL_JOBS_GEMINI_MODEL=
# Max jobs sent to the AI per run (default 30); the rest roll over to the next run.
EXTERNAL_JOBS_MAX_AI_PER_RUN=
# Optional pacing for low Gemini quotas, in AI calls per minute (free tier: 5).
# Each job uses 2 calls. Unset on a paid tier.
EXTERNAL_JOBS_AI_RPM=
# Countries external jobs are listed for (ISO codes). Default: US,IL.
EXTERNAL_JOBS_COUNTRIES=
# Billing (Stripe). TEST-mode keys until go-live is approved. Create 3 monthly
# Prices (Core/Plus/Max), each with currency_options ils/usd/eur matching
# lib/billing/pricing.ts (ILS 790/1490/2490, EUR 230/430/715, USD 255/480/805,
# all tax-exclusive), and put their IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_MAX=
# Either set STRIPE_AUTOMATIC_TAX=1 (Stripe Tax) or a fixed exclusive tax rate id.
STRIPE_AUTOMATIC_TAX=
STRIPE_TAX_RATE_ID=
